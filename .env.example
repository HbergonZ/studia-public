# Portas expostas no computador
APP_PORT=8088
POSTGRES_PORT=5433

# Aplicação
APP_BASE_URL=http://localhost:8088
CI_ENVIRONMENT=development
APP_ENCRYPTION_KEY=

# PostgreSQL
POSTGRES_DB=studia
POSTGRES_USER=studia
POSTGRES_PASSWORD=studia_local

# Gemini é tentado primeiro quando a chave estiver preenchida.
GEMINI_API=
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_SECONDS=600
OPENROUTER_TOTAL_TIMEOUT_SECONDS=300
OPENROUTER_ATTEMPT_TIMEOUT_SECONDS=90
OPENROUTER_MAX_ATTEMPTS=4
# IDs gratuitos preferidos, separados por vírgula. Vazio usa o catálogo atual.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_MAX_TOKENS=50000
